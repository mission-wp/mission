		"interactivity": true,
		"inserter": false
	},
	"attributes": {
		"campaignId": {
			"type": "number",
			"default": 0
		}
	},
	"example": {},
	"textdomain": "mission-donation-platform",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./index.php"
}
